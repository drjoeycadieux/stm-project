# STM developer portal credentials (https://developpeurs.stm.info)
# Only the API key is currently used by the GTFS-RT and i3 endpoints.
# The client secret is stored here for completeness and is never sent to the browser.
STM_API_KEY=your_api_key_here
STM_CLIENT_SECRET=your_client_secret_here

# Optional overrides
STM_API_BASE=https://api.stm.info/pub/od
STM_ORIGIN=http://localhost:5173
PORT=8787

# Cache durations (milliseconds)
VEHICLE_TTL_MS=8000
TRIP_TTL_MS=10000
ALERTS_TTL_MS=60000

# Refresh the static GTFS zip after this many hours
GTFS_MAX_AGE_HOURS=168
